# Settings for running the app with live SEC data. Demo mode and the tests need none of this.
#
# Create your own copy inside app/:  cp .env.example .env   (Windows: copy .env.example .env)
# Then put your own values in app/.env with an editor. Never commit .env, never paste it into a chat.

# Required by the SEC for every request (SEC fair access): your name and your e-mail address.
SEC_USER_AGENT="Firstname Lastname firstname.lastname@example.com"

# Optional: a free FRED API key for the 10-year Treasury yield. Leave empty to use the
# valuation.risk_free_rate value in settings.yaml instead.
FRED_API_KEY=
